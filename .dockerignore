# Git and version control
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
*$py.class
.venv
.venv*/
venv
env
*.egg-info
.eggs
.pytest_cache

# IDE and editor
.idea
.vscode
.cursor
.claude
*.swp
*.swo

# Jupyter
.ipynb_checkpoints
*-checkpoint.ipynb
*.ipynb

# Build artifacts and caches.
#
# db.sqlite3 is excluded: PeptiLine's own operational DB is created fresh by
# `migrate` on first boot (start.sh -> bootstrap), so a local copy must never
# be baked in.
#
# mbpdb_replica.sqlite3 is NOT excluded: it is the checked-in, already-populated
# snapshot of MBPDB's reference tables that the functional-annotation / BLAST
# search reads (see docs/SPLIT_PLAN.md section 3). Nothing loads it at deploy
# time -- the `COPY . /app` in the Dockerfile is the only path data reaches the
# image. Excluding it here is what left the deployed replica empty and made
# every database search fail with "Database search failed. Check server logs."
db.sqlite3
static_files
*.log

# Local dev and test
.env
.env.*
*.env
.DS_Store
uploads/temp/*
!uploads/temp/.gitkeep

# Not needed at runtime -- README docs, source data/reference material for
# local dev, and the test suite. examples/ (32MB of sample datasets) and
# legacy_v1/ (notebooks + a superseded 60MB supplementals/ set) are neither
# read by the running app -- see docs/SPLIT_PLAN.md and legacy_v1/README.md.
README.md
LICENSE
docs
tests
examples
legacy_v1
