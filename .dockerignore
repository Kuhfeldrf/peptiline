# Git and version control
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
*$py.class
.venv
.venv*/
venv
env
*.egg-info
.eggs
.pytest_cache

# IDE and editor
.idea
.vscode
.cursor
.claude
*.swp
*.swo

# Jupyter
.ipynb_checkpoints
*-checkpoint.ipynb
